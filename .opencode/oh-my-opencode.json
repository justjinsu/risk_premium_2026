  "context_injection": {
    "files": [
      "README.md",
      "docs/METHODOLOGY_EQUATIONS.md", 
      "docs/MODEL_OVERVIEW.md",
      "docs/PHYSICAL_RISK_MODEL.md"
    ],
    "rules": [
      "Always maintain academic rigor in climate risk calculations",
      "Cross-reference financial assumptions with KIS methodology",
      "Document uncertainty ranges for all projections",
      "Include sensitivity analysis for key parameters",
      "Validate climate scenarios against scientific literature"
    ]
  },
  "built_in_skills": {
    "git-master": true,
    "playwright": false
  },
  "experimental": {
    "aggressive_truncation": true,
    "auto_resume": true
  }
